NODE_ENV=development
PORT=5455
MONGO_URI=mongodb://127.0.0.1:27017/flex-shop
FRONTEND_URL=http://localhost:5173

# Telegram Mini App
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
TELEGRAM_WEBHOOK_URL=https://api.example.com/api/webhooks/telegram
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
ADMIN_SESSION_HOURS=12

# HUMO notification userbot (MTProto)
HUMO_USERBOT_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=
HUMO_BOT_USERNAME=HUMOcardbot
PAYMENT_BOT_USERNAMES=HUMOcardbot,CardXabarBot
HUMO_CREDIT_KEYWORDS=tushdi,kirim,popolnen,zachislen,credited,пополнен,зачислен,поступил
HUMO_DEBIT_KEYWORDS=yechildi,chiqim,spisan,debit,списан
HUMO_PAYMENT_CODE_MAX=999
HUMO_PAYMENT_AMOUNT_STEP=100

# Lootbar reseller — serverdan tashqariga chiqarmang
LOOTBAR_BASE_URL=https://api.lootbar.gg
LOOTBAR_NICKNAME=
LOOTBAR_EMAIL=
LOOTBAR_PASSWORD=
LOOTBAR_CALLBACK_URL=https://api.example.com/api/webhooks/lootbar/notify
LOOTBAR_TIMEOUT_MS=15000

# Fragment API — Telegram Premium
FRAGMENT_API_BASE_URL=https://fragment-api.uz/api/v1
FRAGMENT_API_KEY=
FRAGMENT_API_TIMEOUT_MS=30000

# Provider catalog cache
CATALOG_CACHE_TTL_MS=600000

# Manual UZS top-up details
TOPUP_CARD_LABEL=UZCARD / HUMO
TOPUP_CARD_NUMBER=8600123456789012
TOPUP_CARD_HOLDER=FLEX_OWNER
TOPUP_MIN_AMOUNT_UZS=10000
